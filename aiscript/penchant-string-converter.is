	"ⅹⅹⅹⅴⅰⅱ": "lrom38",
	"ⅹⅹⅹⅴⅱⅰ": "lrom38",
	"ⅹⅹⅹⅴⅲ": "lrom38",
	"ⅹⅹⅹⅵⅰⅰ": "lrom38",
	"ⅹⅹⅹⅵⅱ": "lrom38",
	"ⅹⅹⅹⅶⅰ": "lrom38",
	"ⅹⅹⅹⅷ": "lrom38",
	"ⅹⅹⅹⅰⅹ": "lrom39",
	"ⅹⅹⅹⅸ": "lrom39",
	"ⅹⅹⅺⅹ": "lrom39"
}
let roman_max_length = 7

let variants = [
	{text: "墨", value: "p"}
	{text: "酸鉄", value: "pr"}
	{text: "警戒", value: "ph"}
	{text: "緑青真鍮", value: "pt"}
	{text: "白銅燐光", value: "pn"}
]

var input_text = ""
var selected_variant = "p"

@emoji(name) {
	`:{name}:`
}

@error_mfm(position, text) {
	`$[fg.color=f44 **エラー: {position}文字目「{text}」に該当するカスタム絵文字がありません。**]`
}

@convert(text) {
	var output = ""
	var index = 0
	var display_position = 1
	while (index < text.len) {
		var matched = false

		// 長い表記から調べ、組字を必ず文字単位変換より優先する。
		var length = roman_max_length
		while ((length >= 2) && !matched) {
			let sequence = text.slice(index, index + length)
			let token = roman_ligatures[sequence]
			if (Core:type(token) == "str") {
				let emoji_name = `{token}{selected_variant}`
				output = `{output}{emoji(emoji_name)}`
				index = index + length
				display_position = display_position + length
				matched = true
			}
			length = length - 1
		}

		if !matched {
			let character = text.slice(index, index + 1)
			let stem = character_map[character]
			if (Core:type(stem) == "str") {
				// スペーサ等のバリアント非依存トークンは全バリアント共通で `{token}p`。
				let emoji_name = if (neutral_tokens.incl(stem)) `{stem}p` else `{stem}{selected_variant}`
				output = `{output}{emoji(emoji_name)}`
			} else {
				output = `{output}\n{error_mfm(display_position, character)}`
			}
			index = index + 1
			display_position = display_position + 1
		}
	}
	output
}

@refresh() {
	let result = convert(input_text)
	Ui:get("result-preview").update({text: result})
	Ui:get("result-source").update({text: result})
}

Ui:render([
	Ui:C:container({
		padding: 1
		rounded: true
		children: [
			Ui:C:text({
				text: "PenchantManufacture 文字列コンバーター"
				bold: true
			})
			Ui:C:textarea({
				default: ""
				label: "変換する文字列"
				caption: "ⅩⅢ～ⅩⅩⅩⅨは字詰め済みの組字へ変換します。"
				onInput: @(value) { input_text = value }
			})
			Ui:C:select({
				items: variants
				default: "p"
				label: "バリアント"
				onChange: @(value) { selected_variant = value }
			})
			Ui:C:button({
				text: "変換"
				primary: true
				rounded: true
				onClick: @() { refresh() }
			})
			Ui:C:text({text: "出力プレビュー", bold: true})
			Ui:C:mfm({text: ""}, "result-preview")
			Ui:C:text({text: "出力MFM", bold: true})
			Ui:C:text({text: "", font: "monospace"}, "result-source")
		]
	})
])
